# Production Environment Configuration
# Copy this file to .env and update ALL values before deployment
# IMPORTANT: Generate secure secrets using scripts/generate-secrets.sh

# Django Settings - CRITICAL: Generate secure SECRET_KEY
DEBUG=False
SECRET_KEY=CHANGE-THIS-GENERATE-SECURE-KEY-MIN-50-CHARS-REQUIRED

# Admin Settings - CRITICAL: Change admin password
ADMIN_PASSWORD=CHANGE-THIS-STRONG-ADMIN-PASSWORD

# Database PostgreSQL - CRITICAL: Use strong password
POSTGRES_DB=videocall_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-THIS-STRONG-DB-PASSWORD
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Application Settings
ROOM_EXPIRY_HOURS=24
MAX_PARTICIPANTS_PER_ROOM=100
SHORT_CODE_LENGTH=6

# CORS Settings - CRITICAL: Update with your production domain
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,localhost,127.0.0.1

# SSL Certificates (paths in system)
SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem
DOMAIN_NAME=your-domain.com

# Streaming Node (SFU) Settings - CRITICAL: Generate secure JWT_SECRET
SFU_HOST=streaming-node
SFU_PORT=8080
JWT_SECRET=CHANGE-THIS-GENERATE-SECURE-JWT-SECRET
SERVER_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Frontend Settings
VITE_API_BASE_URL=https://your-domain.com/api
VITE_WS_BASE_URL=wss://your-domain.com
VITE_SFU_WS_URL=wss://your-domain.com/sfu/ws
VITE_APP_NAME=VideoCall

# Logging
LOG_LEVEL=INFO

# Email Settings (optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Monitoring (optional)
SENTRY_DSN=

# Rate Limiting
RATELIMIT_ENABLE=True
