FROM node:18-alpine

# Install system dependencies
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    freetype-dev \
    harfbuzz \
    ca-certificates \
    ttf-freefont

# Set Puppeteer to skip downloading Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Create app directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy test files
COPY tests/ ./tests/

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S loadtest -u 1001

# Create logs directory
RUN mkdir -p /app/logs && chown -R loadtest:nodejs /app

USER loadtest

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "console.log('Load test client is healthy')"

CMD ["node", "tests/websocket-load-test.js"]