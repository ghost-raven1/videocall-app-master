FROM node:18-alpine

# Install system dependencies for Puppeteer
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    freetype-dev \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    xvfb \
    dbus \
    alsa-lib \
    libxcomposite \
    libxdamage \
    libxrandr \
    libxss \
    libxtst

# Set Puppeteer to skip downloading Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Create app directory
WORKDIR /app

# Copy package files
COPY videocall-frontend/package*.json ./frontend-package.json
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy test files and frontend code
COPY tests/ ./tests/
COPY videocall-frontend/ ./videocall-frontend/

# Build frontend for testing
WORKDIR /app/videocall-frontend
RUN npm ci && npm run build

# Create non-root user
WORKDIR /app
RUN addgroup -g 1001 -S nodejs
RUN adduser -S puppeteer -u 1001

# Create logs directory
RUN mkdir -p /app/logs && chown -R puppeteer:nodejs /app

USER puppeteer

# Set display for virtual framebuffer
ENV DISPLAY=:99

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "console.log('Puppeteer test client is healthy')"

CMD ["node", "tests/multi-user-test.js"]