# Development Environment Configuration
# Copy this file to .env.dev and update values as needed

# Django Settings
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-min-50-chars-required-for-security

# Admin Settings
ADMIN_PASSWORD=dev_admin_password

# Database PostgreSQL
POSTGRES_DB=videocall_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Application Settings
ROOM_EXPIRY_HOURS=24
MAX_PARTICIPANTS_PER_ROOM=100
SHORT_CODE_LENGTH=6

# CORS Settings (Development - allow all origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,nginx

# Streaming Node (SFU) Settings
SFU_HOST=streaming-node
SFU_PORT=8080
JWT_SECRET=dev-jwt-secret-change-in-production
SERVER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Frontend Settings (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_SFU_WS_URL=ws://localhost:8080
VITE_APP_NAME=VideoCall Dev

# Logging
LOG_LEVEL=DEBUG
