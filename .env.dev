# Development Environment Configuration
# Copy this file to .env.dev and update values as needed

# Django Settings
DEBUG=True
SECRET_KEY=Cxl9xdAYtZ9wOKTtT6gJwQnDKyULXh4kN8x7llDqpOTDr--2_HfM-1Sal-agAje1PY0

# Admin Settings
ADMIN_PASSWORD=dev_admin_password

# Database PostgreSQL
POSTGRES_DB=videocall_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Application Settings
ROOM_EXPIRY_HOURS=24
MAX_PARTICIPANTS_PER_ROOM=100
SHORT_CODE_LENGTH=6

# CORS Settings (Development - allow all origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,nginx

# Streaming Node (SFU) Settings
SFU_HOST=streaming-node
SFU_PORT=8080
# Strong JWT secret for SFU config validation (must be >=32 chars and not contain common words)
JWT_SECRET=7c9f5a2e4b1d8c3f7e9a6d4c8b2f1a7e3c9d5b1a6f2e8c4d7b9a3f5c1d8e2a4
SERVER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3001

# Frontend Settings (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
# SFU WebSocket endpoint (must point to /ws for SFU server)
VITE_SFU_WS_URL=ws://localhost:8080/ws
# TURN servers for WebRTC (format: urls:username:credential[,urls:username:credential])
VITE_TURN_SERVERS=turn:localhost:3478:turnuser:turnpassword
VITE_APP_NAME=VideoCall Dev

# Logging
LOG_LEVEL=DEBUG
