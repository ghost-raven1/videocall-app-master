# 🔐 SECURITY NOTICE: Use unique, strong values for production
# Generate secure keys:
# python -c "import secrets; print('SECRET_KEY=' + secrets.token_urlsafe(50))"
# python -c "import secrets; print('JWT_SECRET=' + secrets.token_hex(32))"

# Django
DEBUG=False
SECRET_KEY=

# Admin
ADMIN_PASSWORD=

# PostgreSQL (managed by docker-compose)
POSTGRES_DB=videocall_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# App limits
ROOM_EXPIRY_HOURS=24
MAX_PARTICIPANTS_PER_ROOM=100
SHORT_CODE_LENGTH=6

# CORS/Hosts (set to your domain(s))
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# SSL cert paths (optional if terminating TLS elsewhere)
SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem
DOMAIN_NAME=your-domain.com

# Streaming Node (SFU)
SFU_HOST=streaming-node
SFU_PORT=8080
JWT_SECRET=
SERVER_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Frontend
VITE_API_BASE_URL=https://your-domain.com/api
VITE_WS_BASE_URL=wss://your-domain.com
VITE_APP_NAME=VideoCall
